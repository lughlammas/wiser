# Copie para .env (nunca versionado). Só o servidor lê este arquivo.
# Provedor ÚNICO usado (sem troca automática): ollama | gemini | argos
WISER_PROVIDER=ollama
# Modelo (ollama: ex. qwen2.5:1.5b; gemini: ex. gemini-flash-latest)
WISER_MODEL=qwen2.5:1.5b
WISER_OLLAMA_URL=http://localhost:11434/v1
# GEMINI_API_KEY=coloque-aqui-somente-no-servidor
WISER_CHUNK_CHARS=900
WISER_PORT=8765
